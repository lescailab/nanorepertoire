nextflow_process {

    name "Test Process CLUSTER_MOSTFREQUENT"
    script "../main.nf"
    process "CLUSTER_MOSTFREQUENT"
    config "./nextflow.config"
    tag "nanobodies"
    tag "modules"
    tag "clustermostfrequent"

    test("most-frequent-sequence-per-cluster") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test1', single_end:false ], // meta map
                    file("${moduleDir}/tests/data/test_sequences.fasta", checkIfExists: true),
                    file("${moduleDir}/tests/data/test_clusters.clstr", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0][1]).readLines()
            assertAll(
                { assert process.success },
                // cluster 0: the representative (135 aa, extra stretch after FR4) is replaced by the
                // 116 aa sequence present in three copies
                { assert rows[1].startsWith("1\t2\t5\t3\t0.6000\t135\t116\tno") },
                // cluster 1: a singleton keeps its only sequence
                { assert rows[2].startsWith("6\t6\t1\t1\t1.0000") },
                // cluster 2: two sequences with two copies each; the tie goes to the first member
                { assert rows[3].startsWith("7\t7\t4\t2\t0.5000\t115\t115\tyes") },
                { assert snapshot(process.out).match() }
            )
        }

    }
}
